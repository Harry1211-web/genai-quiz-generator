# Generator model. "fake" = fake LLM for zero-cost dry runs.
LLM_MODEL=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Prices in USD per 1M input / output tokens (check your provider's pricing page)
LLM_PRICE_IN=0.15
LLM_PRICE_OUT=0.60
# Set to false if the endpoint returns HTTP 400 for response_format
LLM_JSON_MODE=true

# Verifier model (answers each question again) - should differ from the generator.
# Ollama: http://localhost:11434/v1
VERIFY_MODEL=fake
VERIFY_BASE_URL=http://localhost:11434/v1
VERIFY_API_KEY=

# Judge model (LLM-as-judge), only used during evaluation
JUDGE_MODEL=fake
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=

# Hard spending cap per process (USD) - stops when exceeded
LLM_BUDGET_USD=2
