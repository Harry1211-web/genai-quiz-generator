# Models are declared once each, by number: LLM_<SETTING>_<n>.
# Roles (generator / verifier / judge) are NOT set here: the defaults are in quizgen/llm.py
# (DEFAULT_ROLES: generator 1, verifier 2, judge 1); change them with --generator / --verifier / --judge
# or per configuration in eval/configs.json, e.g. {"generator": 2, "verifier": 1}.
# A model whose LLM_MODEL_<n> is missing runs as a fake model (zero-cost dry run, used by the tests).

# Model 1 - hosted API model
LLM_MODEL_1=gpt-6-luna
LLM_BASE_URL_1=https://api.openai.com/v1
LLM_API_KEY_1=
# USD per 1M input / output tokens (check the provider's pricing page)
LLM_PRICE_IN_1=0.10
LLM_PRICE_OUT_1=0.50

# Model 2 - local model through Ollama (a base URL on port 11434 = Ollama; no key, no price)
LLM_MODEL_2=qwen3.5:4b
LLM_BASE_URL_2=http://localhost:11434

# Optional extras for any model n:
#   LLM_THINK_<n>=false|true|default   thinking mode of Ollama models (default false: ~15x faster)
#   LLM_TIMEOUT_<n>=300                 seconds to wait for one reply
#   LLM_NUM_CTX_<n>=16384               context window of an Ollama model (prompt + thinking + answer);
#                                       Ollama's default is small: raise it when thinking is on
#   LLM_REASONING_EFFORT_<n>=low        for API models with adjustable reasoning
#   LLM_JSON_MODE_<n>=false             if the endpoint rejects response_format (HTTP 400)
#   LLM_TEMPERATURE_<n>=true            send temperature to an API model that supports it (off by default:
#                                       gpt-6-luna only accepts its default temperature)
#   LLM_PROVIDER_<n>=ollama|openai      only if the port-11434 rule does not fit

# Hard spending cap per process and model (USD)
LLM_BUDGET_USD=2
