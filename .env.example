# Model sinh câu hỏi. "fake" = LLM giả để chạy thử không tốn tiền.
LLM_MODEL=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_PRICE_IN=0.15      # USD / 1 triệu token vào (xem bảng giá nhà cung cấp)
LLM_PRICE_OUT=0.60
LLM_JSON_MODE=true     # đặt false nếu endpoint báo lỗi 400 với response_format
# Model kiểm tra (trả lời lại) – nên khác model sinh. Ollama: http://localhost:11434/v1
VERIFY_MODEL=fake
VERIFY_BASE_URL=http://localhost:11434/v1
VERIFY_API_KEY=
# Model chấm (LLM-as-judge)
JUDGE_MODEL=fake
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
# Ngân sách tối đa mỗi tiến trình (USD) – dừng khi vượt
LLM_BUDGET_USD=2
